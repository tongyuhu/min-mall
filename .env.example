# 复制为 .env 后替换所有密码；本机 Java 进程需另导入这些变量。
MYSQL_DATABASE=mini_mall
MYSQL_USER=mall
MYSQL_PASSWORD=请替换数据库密码
MYSQL_ROOT_PASSWORD=请替换数据库管理密码
REDIS_PASSWORD=请替换缓存密码
MYSQL_PORT=13306
REDIS_PORT=16379
SERVER_PORT=18080
MALL_SIMULATION_ENABLED=true
MALL_SIMULATION_KEY=请替换为至少32字节的开发密钥
MALL_ADMIN_PASSWORD=请替换后台初始密码
MALL_SEED_ENABLED=true
MALL_DEMO_PASSWORD=请替换买家初始密码
